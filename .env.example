# AniList does not require an API key for public GraphQL reads.
ANILIST_GRAPHQL_ENDPOINT=https://graphql.anilist.co

# Optional OpenAI recommendation reranking. Keep server-only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Supabase auth, saved anime, ratings, and taste profile.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
